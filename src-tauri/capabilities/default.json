{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:allow-open-url",
		"opener:allow-default-urls",
		"dialog:allow-open",
		"updater:allow-check",
		"updater:allow-download",
		"updater:allow-install",
		"process:allow-restart"
	]
}
