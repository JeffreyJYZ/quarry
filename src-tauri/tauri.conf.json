{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "quarry",
	"version": "0.1.0-alpha.39",
	"identifier": "land.jyz.quarry",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "quarry",
				"width": 1360,
				"height": 880,
				"minWidth": 960,
				"minHeight": 600,
				"theme": "Dark",
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMkFDRjMxRkQ4N0RCNDEKUldSQjI0ZjlNYzhxb1VpZXdmUjhPQlZmbnFNcURNc2NQZW0zTERnUWl4dWJhc2NaOWNOZE12QlMK",
			"endpoints": [
				"https://github.com/JeffreyJYZ/quarry/releases/latest/download/latest.json"
			]
		}
	}
}
